# Backend API URL (for Vercel deployment, enter your deployed backend URL, e.g. https://your-backend.onrender.com)
VITE_SERVER_URL=https://your-backend-url.com

# Firebase Web API Key - Required for Google Sign-in to work
VITE_FIREBASE_APIKEY=YOUR_FIREBASE_WEB_API_KEY_GOES_HERE

# LiveKit WebRTC Cloud URL (Optional)
VITE_LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# Optional Payment Gateway Key ID
VITE_RAZORPAY_KEY_ID=YOUR_OPTIONAL_RAZORPAY_KEY_ID_GOES_HERE
